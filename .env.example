DATABASE_URL=postgres://localhost:5432/relay_incident
# Required — fine-grained PAT with Contents, Pull requests, Deployments (read/write)
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=amit-lekhak/production-incident-agent
GITHUB_DEPLOY_ENV=production
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Watcher / ticker
WATCHER_INTERVAL_MS=5000
TICKER_INTERVAL_MS=3000
LATENCY_P95_THRESHOLD_MS=2000
ERROR_RATE_THRESHOLD=0.05
DIAGNOSIS_MAX_RETRIES=2
VERIFY_SAMPLES=3
VERIFY_INTERVAL_MS=1000
VERIFY_TIMEOUT_MS=15000
EVAL_AGENT_TIMEOUT_MS=90000
METRIC_RETENTION_HOURS=6
